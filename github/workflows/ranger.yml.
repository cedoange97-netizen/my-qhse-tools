name: Ranger le dépôt
on: workflow_dispatch
permissions:
  contents: write
jobs:
  ranger:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: Déplacer les fichiers et corriger les chemins
        run: |
          [ -d css ] && { echo "Déjà rangé"; exit 0; }
          mkdir -p css js/data outils-admin
          CSS="style quiz bibliotheque outils terrain checklists parametres liens documents"
          CODE="app parametres bibliotheque terrain checklists quiz cloud-sync documents documents-acces lecteur-office liens"
          DATA="banque-management banque-qualite banque-sante-securite banque-hygiene banque-environnement banque-transversal banque-livret images-livret sujets causes glossaire checklists-data-1 checklists-data-2 checklists-data-3 logo-myqhse documents-liste"
          for n in $CSS; do git mv "$n.css" css/; sed -i "s#href=\"$n\.css#href=\"css/$n.css#g" index.html; done
          for n in $CODE; do git mv "$n.js" js/; sed -i "s#src=\"$n\.js#src=\"js/$n.js#g" index.html; done
          for n in $DATA; do git mv "$n.js" js/data/; sed -i "s#src=\"$n\.js#src=\"js/data/$n.js#g" index.html; done
          git mv chiffrer.mjs outils-admin/
          git mv schema-photos.sql outils-admin/
          git rm -q --ignore-unmatch documents/vide.txt
          sed -i 's#s\.src = "cloud-sync\.js"#s.src = "js/cloud-sync.js"#' js/quiz.js
          sed -i 's#"\.\./documents-acces\.js"#"../js/documents-acces.js"#' outils-admin/chiffrer.mjs
          git config user.name "rangement"
          git config user.email "rangement@users.noreply.github.com"
          git add -A
          git commit -m "Rangement : css/, js/, js/data/, outils-admin/"
          git push
